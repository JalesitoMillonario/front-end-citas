      "webhookId": "chatbot-citas-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "session_id",
              "value": "={{ $json.body.from || $json.query.session_id || 'default-session' }}",
