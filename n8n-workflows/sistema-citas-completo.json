      "id": "http-cancelar",
      "name": "❌ Cancelar Cita",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 650]
    },
    {
      "parameters": {
        "jsCode": "// Formatear resultado de disponibilidad\nconst data = $input.first().json;\n\nconst libres = data.slots.filter(s => s.disponible);\nconst ocupados = data.slots.filter(s => !s.disponible);\n\nconst resultado = {\n  accion: 'disponibilidad',\n  fecha: data.fecha,\n  resumen: {\n    total_slots: data.resumen.total_slots,\n    libres: data.resumen.libres,\n    ocupados: data.resumen.ocupados\n  },\n  horarios_libres: libres.map(s => s.hora),\n  horarios_ocupados: ocupados.map(s => ({\n    hora: s.hora,\n    cliente: s.cliente,\n    servicio: s.ocupado_por\n  })),\n  mensaje: `📅 Disponibilidad para ${data.fecha}:\\n✅ ${data.resumen.libres} slots libres\\n❌ ${data.resumen.ocupados} slots ocupados`\n};\n\nreturn { json: resultado };"
      },
      "id": "format-disponibilidad",
      "name": "✨ Formatear Disponibilidad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "jsCode": "// Formatear resultado de cita creada\nconst cita = $input.first().json;\n\nconst resultado = {\n  accion: 'crear',\n  success: true,\n  cita_id: cita.cita_id,\n  detalles: {\n    cliente: cita.cliente_nombre,\n    telefono: cita.cliente_telefono,\n    servicio: cita.servicio_nombre,\n    fecha: cita.fecha,\n    hora: `${cita.hora_inicio} - ${cita.hora_fin}`,\n    precio: `${cita.precio_servicio}€`,\n    duracion: `${cita.servicio_duracion} min`,\n    estado: cita.estado\n  },\n  mensaje: `✅ CITA CREADA\\n👤 ${cita.cliente_nombre}\\n💆‍♀️ ${cita.servicio_nombre}\\n📅 ${cita.fecha} a las ${cita.hora_inicio}\\n💰 ${cita.precio_servicio}€`\n};\n\nreturn { json: resultado };"
      },
      "id": "format-crear",
      "name": "✨ Formatear Crear",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 350]
    },
    {
      "parameters": {
        "jsCode": "// Formatear lista de citas\nconst citas = $input.all().map(item => item.json);\n\nconst porEstado = {\n  pendiente: citas.filter(c => c.estado === 'pendiente').length,\n  confirmada: citas.filter(c => c.estado === 'confirmada').length,\n  completada: citas.filter(c => c.estado === 'completada').length,\n  cancelada: citas.filter(c => c.estado === 'cancelada').length\n};\n\nconst resultado = {\n  accion: 'listar',\n  total: citas.length,\n  por_estado: porEstado,\n  citas: citas.map(c => ({\n    id: c.cita_id,\n    cliente: c.cliente_nombre,\n    telefono: c.cliente_telefono,\n    servicio: c.servicio_nombre,\n    fecha: c.fecha,\n    hora: `${c.hora_inicio} - ${c.hora_fin}`,\n    estado: c.estado,\n    precio: `${c.precio_servicio}€`\n  })),\n  mensaje: `📋 LISTADO DE CITAS\\nTotal: ${citas.length}\\n⏳ Pendientes: ${porEstado.pendiente}\\n✅ Confirmadas: ${porEstado.confirmada}\\n✔️ Completadas: ${porEstado.completada}\\n❌ Canceladas: ${porEstado.cancelada}`\n};\n\nreturn { json: resultado };"
      },
      "id": "format-listar",
      "name": "✨ Formatear Listar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 500]
    },
    {
      "parameters": {
        "jsCode": "// Formatear resultado de cancelación\nconst data = $input.first().json;\n\nconst resultado = {\n  accion: 'cancelar',\n  success: data.success,\n  mensaje: `❌ CITA CANCELADA\\n${data.message}`\n};\n\nreturn { json: resultado };"
      },
      "id": "format-cancelar",
      "name": "✨ Formatear Cancelar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 650]
    }
