# Puerto del servidor
PORT=5000

# JWT Secret para autenticación
JWT_SECRET=tu_secreto_super_seguro_cambiame

# Base de datos SQLite
DATABASE_PATH=./database/citas.db

# URL del webhook de n8n para recordatorios
N8N_WEBHOOK_URL=http://localhost:5678/webhook/recordatorio-cita

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Tiempo de recordatorio (en horas antes de la cita)
REMINDER_HOURS_BEFORE=12
